{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks.cs",
              "--",
              "session-start",
              "${CLAUDE_PLUGIN_ROOT}"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks.cs",
              "--",
              "lock-specs"
            ],
            "timeout": 60
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks.cs",
              "--",
              "no-raw-commit"
            ],
            "timeout": 60,
            "if": "Bash(git commit *)"
          }
        ]
      },
      {
        "matcher": "PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks.cs",
              "--",
              "no-raw-commit"
            ],
            "timeout": 60,
            "if": "PowerShell(git commit *)"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "dotnet",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks.cs",
              "--",
              "format"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "dotnet",
            "args": [
              "run",
              "${CLAUDE_PLUGIN_ROOT}/scripts/hooks.cs",
              "--",
              "stop"
            ],
            "timeout": 60
          }
        ]
      }
    ]
  }
}
