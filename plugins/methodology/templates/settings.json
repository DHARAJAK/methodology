{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(git push -u origin feat/*)",
      "Bash(git push origin feat/*)",
      "Bash(dotnet run *)",
      "Bash(dotnet test *)",
      "Bash(dotnet build *)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "PowerShell(git push -u origin feat/*)",
      "PowerShell(git push origin feat/*)",
      "PowerShell(dotnet run *)",
      "PowerShell(dotnet test *)",
      "PowerShell(dotnet build *)",
      "PowerShell(git status*)",
      "PowerShell(git diff*)",
      "PowerShell(git log*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Bash(rm -rf *)",
      "Bash(npm publish *)",
      "Bash(dotnet nuget push *)",
      "Bash(twine upload *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main)",
      "Bash(git push origin master)",
      "PowerShell(rm -rf *)",
      "PowerShell(Remove-Item *-Recurse*)",
      "PowerShell(npm publish *)",
      "PowerShell(dotnet nuget push *)",
      "PowerShell(twine upload *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git push origin main)",
      "PowerShell(git push origin master)",
      "Bash(git push * main)",
      "Bash(git push * master)",
      "Bash(git push * HEAD:*)",
      "Bash(git push --force-with-lease *)",
      "PowerShell(git push * main)",
      "PowerShell(git push * master)",
      "PowerShell(git push * HEAD:*)",
      "PowerShell(git push --force-with-lease *)"
    ],
    "ask": [
      "Bash(dotnet add package *)",
      "Bash(npm install *)",
      "Bash(npm i *)",
      "Bash(yarn add *)",
      "Bash(pnpm add *)",
      "Bash(pip install *)",
      "Bash(uv add *)",
      "Bash(go get *)",
      "PowerShell(dotnet add package *)",
      "PowerShell(npm install *)",
      "PowerShell(npm i *)",
      "PowerShell(yarn add *)",
      "PowerShell(pnpm add *)",
      "PowerShell(pip install *)",
      "PowerShell(uv add *)",
      "PowerShell(go get *)"
    ]
  }
}
